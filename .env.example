# Frontend (embedded at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://hyperrisk:hyperrisk@localhost:5432/hyperrisk
HYPERLIQUID_REST_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
REQUEST_TIMEOUT_SECONDS=5
STALE_AFTER_SECONDS=10
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173
LOG_LEVEL=INFO

# Optional. The deterministic template explainer works without this value.
OPENAI_API_KEY=
